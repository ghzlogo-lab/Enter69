# Obrigatória: palavra-passe do add "psique" (mínimo 8 caracteres; use uma longa e única)
ADD_PASSWORD=
# Nome do add (só quem tiver este nome + a palavra-passe pode adicionar/eliminar músicas)
ADD_NAME=psique
# Pasta onde ficam músicas e dados (use um disco persistente no alojamento)
DATA_DIR=./data
# Opcionais
PORT=3000
SONG_TTL_HOURS=168
MAX_AUDIO_MB=15
MAX_SONGS=50
# 1 = o site está atrás de um proxy/HTTPS do alojamento (Render, Railway, Fly...). 0 = exposto diretamente.
TRUST_PROXY_HOPS=1
